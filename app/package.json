{
  "name": "family-tree",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "cd .. && firebase emulators:exec --only firestore,storage --project family-tree-rules-test \"cd app && vitest run\"",
    "test:unit": "vitest run --exclude '**/rules.test.ts'",
    "test:rules": "cd .. && firebase emulators:exec --only firestore,storage --project family-tree-rules-test \"cd app && vitest run tests/rules.test.ts\"",
    "preview": "vite preview",
    "seed": "tsx scripts/seed-firestore.mts",
    "icons": "tsx scripts/make-icons.mts"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/noto-serif-kannada": "^5.3.0",
    "@fontsource/noto-serif-telugu": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "firebase": "^12.16.0",
    "motion": "^12.42.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "firebase-admin": "^14.2.0",
    "oxlint": "^1.71.0",
    "sharp": "^0.35.3",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
